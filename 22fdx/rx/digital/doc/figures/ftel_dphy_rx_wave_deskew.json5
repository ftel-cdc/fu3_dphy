// Figure 5-3 - deskew burst at the PPI (spec.md 5.1; 4.6 deskew-burst detection).
// rxskewcalhs_x is set on every delay-line entry written from the detection until the lane leaves
// HS mode, so it falls after rxactivehs_x (which the EoT cut clears after the last transition).
// stopstate_x rises before rxskewcalhs_x falls with PARA_STOP_DRAIN_EN = 0, after it with 1 (4.5).
{ signal: [
  { name: 'rxbyteclkhs',    wave: 'p.|....|....|...' },
  { name: 'rxdatahs_x',     wave: 'x.|....|....|...' },
  { name: 'rxactivehs_x',   wave: '0.|1...|..0.|...' },
  { name: 'rxskewcalhs_x',  wave: '0.|...1|....|.0.' },
  {                                                   node: '..........G...H.' },
  { name: 'rxvalidhs_x',    wave: '0.|....|....|...' },
  { name: 'rxsynchs_x',     wave: '0.|....|....|...' },
  { name: 'errsoths_x',     wave: '0.|....|....|...' },
  { name: 'stopstate_x (0)', wave: '10|....|x1..|...' },
  { name: 'stopstate_x (1)', wave: '10|....|....|..1' },
],
  edge: ['G<->H eot_skip_bytes'],
  head: { text: 'PPI, one data lane: deskew burst' },
  foot: { text: '(0), (1): PARA_STOP_DRAIN_EN; the lock on the deskew sync is cancelled before the PPI (4.6)' },
  config: { hscale: 1, arcFontSize: 12 }
}
