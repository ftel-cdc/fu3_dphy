# Local environment of 22fdx/rx/digital.
# Copy this file to .env in the same folder and replace every value with the one of your installation.
# .env is never committed (.gitignore): the names and paths it holds stay on your machine.
# Format: KEY=value lines, read by bash (quote values that contain spaces).

# ---- Standard-cell library of the target technology: syn/run_syn.sh, syn/tech.tcl ------------
# Timing models (.db), one file per corner: $FTEL_LIB_DB_DIR/$FTEL_LIB_DB_PREFIX<corner>.db
FTEL_LIB_DB_DIR=/path/to/the/library/timing/db
FTEL_LIB_DB_PREFIX=LIBRARY_FILE_PREFIX_
# Corners run when run_syn.sh gets no --corner (the slow corners at low and at high temperature),
# named as in the .db file names
FTEL_LIB_CORNERS="SLOW_CORNER_COLD SLOW_CORNER_HOT"
# Units of the library: time units per ns, capacitance units per fF
FTEL_LIB_TIME_PER_NS=1000.0
FTEL_LIB_CAP_PER_FF=1.0
# Buffer cell that drives the inputs of the design (set_driving_cell)
FTEL_LIB_DRIVE_CELL=BUFFER_CELL
# Pins of the library flip-flops that the timing reports name: clock, data, asynchronous reset
FTEL_LIB_FF_PIN_CLK=CLOCK_PIN
FTEL_LIB_FF_PIN_D=DATA_PIN
FTEL_LIB_FF_PIN_RESET=RESET_PIN
# Integrated clock-gating cell for rising-edge flip-flops, latch based, test enable before the latch
# (Liberty: latch_posedge_precontrol), and its pins: syn/cells/m_ftel_dphy_rx_cg.sv instantiates it
FTEL_LIB_CG_CELL=CLOCK_GATE_CELL
FTEL_LIB_CG_PIN_CLK=CLOCK_PIN
FTEL_LIB_CG_PIN_EN=ENABLE_PIN
FTEL_LIB_CG_PIN_TE=TEST_ENABLE_PIN
FTEL_LIB_CG_PIN_GCLK=GATED_CLOCK_PIN
# Clock inverter cell and its pins: syn/cells/m_ftel_dphy_rx_clk_inv.sv instantiates it
FTEL_LIB_CKINV_CELL=CLOCK_INVERTER_CELL
FTEL_LIB_CKINV_PIN_IN=INPUT_PIN
FTEL_LIB_CKINV_PIN_OUT=OUTPUT_PIN
